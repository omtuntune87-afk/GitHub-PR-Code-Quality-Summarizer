# GitHub access token.
# Required when posting comments. A token with pull-requests: write is needed
# for private repositories; public read-only tokens may be enough for reading.
PR_LENS_GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Optional: GitHub Enterprise Server API base URL.
# PR_LENS_GITHUB_API_URL=https://github.example.com/api/v3

# Gemini OpenAI-compatible chat completions endpoint.
PR_LENS_LLM_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PR_LENS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
PR_LENS_LLM_MODEL=gemini-3.5-flash-lite

# Review limits.
# PR_LENS_MAX_TOKENS=4000
# PR_LENS_MAX_DIFF_CHARS=60000
# PR_LENS_MAX_COMMENT_CHARS=60000

# Additional comma-separated glob patterns to exclude from review.
# Built-in exclusions cover lockfiles, minified assets, and generated files.
# PR_LENS_EXCLUDE=internal/generated/**,*.snap

# Account that owns an existing pr-lens comment; posting updates only a marked
# comment written by this account. GitHub Actions uses github-actions[bot].
# PR_LENS_COMMENT_AUTHOR=github-actions[bot]
