# GitHub access token.
# Required when posting comments. A read-only token is enough for public PRs.
PR_LENS_GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Optional: GitHub Enterprise Server API base URL.
# PR_LENS_GITHUB_API_URL=https://github.example.com/api/v3

# OpenAI-compatible chat completions endpoint.
PR_LENS_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# PR_LENS_LLM_BASE_URL=https://api.openai.com/v1
# PR_LENS_LLM_MODEL=gpt-4o-mini

# Review limits (characters).
# PR_LENS_MAX_DIFF_CHARS=60000
# PR_LENS_MAX_COMMENT_CHARS=60000
