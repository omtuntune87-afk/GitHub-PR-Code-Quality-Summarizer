# pr-lens configuration template.
# Copy this file to .env and replace only the values you need. Command-line
# options override environment variables. Never commit a filled-in .env.

# Required for every review. Gemini is the default OpenAI-compatible provider.
PR_LENS_LLM_API_KEY=your-gemini-api-key
PR_LENS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
PR_LENS_LLM_MODEL=gemini-3.5-flash-lite

# Required only for --post. The token must be allowed to write issue comments
# on the target repository. GITHUB_TOKEN is accepted as a fallback.
# PR_LENS_GITHUB_TOKEN=your-github-token

# GitHub Enterprise Server API base URL.
# PR_LENS_GITHUB_API_URL=https://github.example.com/api/v3

# Review limits. Max tokens must be 1-100000. Comment length is capped at 65000.
# PR_LENS_MAX_TOKENS=4000
# PR_LENS_MAX_DIFF_CHARS=60000
# PR_LENS_MAX_COMMENT_CHARS=60000

# Additional comma-separated glob patterns to exclude from the review.
# Built-in exclusions are path-based only and cover lockfiles, minified assets,
# and generated/compiled paths. Renames are excluded only when both paths match.
# PR_LENS_EXCLUDE=internal/generated/**,*.snap

# Account allowed to own an existing marked pr-lens comment. GitHub Actions uses
# github-actions[bot] by default.
# PR_LENS_COMMENT_AUTHOR=github-actions[bot]
